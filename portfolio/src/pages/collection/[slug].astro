---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionBook from '../../components/collection/CollectionBook.astro';
import { getCollectionPaths, getCollectionBookData } from '../../lib/queries';
import { urlFor } from '../../lib/sanity';

export async function getStaticPaths() {
  const slugs = await getCollectionPaths();
  return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const collection = await getCollectionBookData(slug as string);

if (!collection) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found'
  });
}

const schemaUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : `https://benhickmanphotography.com${Astro.url.pathname}`;
const galleryImages = collection.spreads
  .flatMap((spread) => {
    if (spread.photo?.image?.asset) return [urlFor(spread.photo.image).width(1600).url()];
    if (spread.photos?.length) {
      return spread.photos
        .filter((photo) => photo?.image?.asset)
        .map((photo) => urlFor(photo.image).width(1600).url());
    }
    return [];
  })
  .filter(Boolean);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": `${collection.title} | Ben Hickman Photography Portfolio`,
  "url": schemaUrl,
  "author": {
    "@type": "Person",
    "name": "Ben Hickman"
  },
  "image": galleryImages
};
---

<BaseLayout
  title={`${collection.title} | Ben Hickman Photography Portfolio`}
  description={collection.description}
  bookMode={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {collection.spreads.length > 0 ? (
    <CollectionBook title={collection.title} spreads={collection.spreads} />
  ) : (
    <div class="min-h-[100dvh] flex items-center justify-center px-6">
      <p class="text-center opacity-50">No spreads in this collection yet.</p>
    </div>
  )}
</BaseLayout>

<style is:global>
  html.book-snap {
    scroll-behavior: smooth;
    overflow: hidden;
  }
  body.book-mode {
    overflow: hidden;
  }
  body.book-mode main.book-main {
    padding: 0;
    margin: 0;
  }
  body.book-mode nav:not(#book-nav) {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
</style>
