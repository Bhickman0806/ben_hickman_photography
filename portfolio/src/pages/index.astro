---
import { getHomePage } from '../lib/queries';
import { urlFor, getResponsiveProps } from '../lib/sanity';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import PhotoCard from '../components/PhotoCard.astro';
import Lightbox from '../components/Lightbox.astro';

const homeData = await getHomePage();

const coverThemes = ['coral', 'green', 'gradient', 'grayscale'] as const;

const projects = (homeData?.featuredCollections || [])
  .filter(Boolean)
  .map((collection: any, i: number) => ({
  subtitle: collection.subtitle || "Collection",
  title: collection.title,
  description: collection.description,
  image: collection.image && collection.image.asset && typeof collection.image.asset._ref === 'string' && collection.image.asset._ref.startsWith('image-') ? urlFor(collection.image).width(1600).url() : "",
  ...getResponsiveProps(collection.image, { width: 800, aspectRatio: 16/10, sizes: '(min-width: 768px) 66vw, 100vw' }),
  alt: collection.alt || collection.title,
  linkHref: `/collection/${collection.slug}`,
  linkLabel: "Explore",
  reverse: false,
  theme: coverThemes[i % coverThemes.length],
})) || [];
---

<BaseLayout>
  <div id="home-slider-container" class="home-slider-container overflow-x-clip w-full">
    <div class="slider-section" data-slide-index="0">
      <HeroSection 
        images={homeData?.heroImages}
      />
    </div>

    <!-- Content Section: List of Project Rows -->
    <section class="max-w-[90%] mx-auto pt-16 pb-32 space-y-32 mobile-space-y-0">
      {projects.map((project, i) => (
        <div class="slider-section" data-slide-index={i + 1}>
          <PhotoCard {...project} featured={i === 0} />
        </div>
      ))}
    </section>
  </div>

  <Lightbox />
</BaseLayout>

<style>
  /* Base styles for the slider sections */
  @media (max-width: 767px) {
    :global(html.home-snap) {
      scroll-snap-type: y mandatory;
    }
    .home-slider-container {
      position: relative;
      width: 100%;
    }
    .mobile-space-y-0 > :not([hidden]) ~ :not([hidden]) {
      margin-top: 0;
    }
    .slider-section {
      width: 100%;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: flex-start; /* Ensure top alignment */
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }
</style>

<script>
  const updateSnapClass = () => {
    if (window.location.pathname === '/') {
      document.documentElement.classList.add('home-snap');
    } else {
      document.documentElement.classList.remove('home-snap');
    }
  };

  // Run on page load and astro page transitions
  document.addEventListener('astro:page-load', updateSnapClass);
  updateSnapClass();

  // If using intersection observer to disable snapping when footer is visible
  document.addEventListener('DOMContentLoaded', () => {
      // Find the footer so we can disable snap when it comes into view to prevent erratic bouncing
      const footer = document.querySelector('footer');
      if (!footer) return;

      const observer = new IntersectionObserver((entries) => {
        if (window.location.pathname !== '/' || window.innerWidth >= 768) return;
        
        const footerIsVisible = entries[0].isIntersecting;
        if (footerIsVisible) {
          // If the user scrolls down to the footer, change from mandatory to proximity or none so it stops trying to jump back up
          document.documentElement.style.scrollSnapType = 'y proximity'; // or 'none'
        } else {
          // Re-enable mandatory snap when they scroll back up
          document.documentElement.style.scrollSnapType = ''; // Let the CSS win
        }
      }, { rootMargin: '0px', threshold: 0.1 });

      observer.observe(footer);
  });
</script>
