---
import { getSiteSettings } from '../lib/queries';

const settings = await getSiteSettings();
const links = (settings?.navLinks || [
  { label: 'Writing', href: '/writing' },
  { label: 'Contact', href: '/contact' },
]).filter((link: any) => link.label.toLowerCase() !== 'archive');
const siteName = settings?.siteName || 'Ben Hickman Photography Portfolio';
---
<script src="https://unpkg.com/@lottiefiles/dotlottie-wc@latest/dist/dotlottie-wc.js" type="module"></script>
<nav id="navbar" class="fixed top-0 left-0 w-full z-50 px-8 py-6 text-primary transition-all duration-300">
  <div class="flex items-center justify-between w-full">
    <!-- Left: Logo/Name -->
    <a href="/" data-home-link class="max-[650px]:hidden flex items-center gap-4 hover:opacity-50 transition-opacity">
      <div class="flex gap-1">
        <span class="w-8 h-[1px] bg-current"></span>
        <span class="w-4 h-[1px] bg-current"></span>
      </div>
      <span class="text-[10px] uppercase tracking-[0.2em] font-medium">Ben Hickman</span>
    </a>

    <!-- Left: Writing Link (Mobile Only) -->
    {links.filter(link => link.label.toLowerCase() === 'writing').map(link => (
      <a href={link.href}
         class="hidden max-[650px]:block text-[10px] uppercase tracking-[0.2em] font-medium hover:opacity-50 transition-opacity">
        {link.label}
      </a>
    ))}

    <!-- Center: Brand Logo -->
    <div class="absolute left-1/2 -translate-x-1/2">
      <a href="/" data-home-link class="flex items-center justify-center">
        <dotlottie-wc id="lottie-logo" src="/animated_abstract_logo.lottie" background="transparent" speed="1" class="h-[4.2rem] w-[4.2rem] mt-2"></dotlottie-wc>
      </a>
    </div>

    <!-- Right: Navigation Links + Theme Toggle -->
    <div class="flex items-center gap-8 ml-auto">
      {links.map(link => (
        <a href={link.href}
           class={`text-[10px] uppercase tracking-[0.2em] font-medium hover:opacity-50 transition-opacity ${link.label === 'Archive' ? 'max-[650px]:hidden' : ''} ${link.label === 'Contact' ? 'max-[500px]:hidden' : ''} ${link.label.toLowerCase() === 'writing' ? 'max-[650px]:hidden' : ''}`.trim()}>
          {link.label}
        </a>
      ))}


    </div>
  </div>
</nav>



<script>
  let lastScrollY = window.scrollY;
  let navHidden = false;

  const handleScroll = () => {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;
    const currentScrollY = window.scrollY;
    const lottiePlayer = document.getElementById('lottie-logo') as any;

    if (currentScrollY > lastScrollY && currentScrollY > 50) {
      if (!navHidden) {
        navbar.classList.add("-translate-y-full");
        navHidden = true;
        if (lottiePlayer && lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.setMode === 'function') {
          lottiePlayer.dotLottie.setMode('reverse');
          lottiePlayer.dotLottie.play();
        }
      }
    } else {
      if (navHidden) {
        navbar.classList.remove("-translate-y-full");
        navHidden = false;
        if (lottiePlayer && lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.setMode === 'function') {
          lottiePlayer.dotLottie.setMode('forward');
          lottiePlayer.dotLottie.play();
        }
      }
    }

    if (currentScrollY > 20) {
      navbar.classList.add("bg-surface/75", "backdrop-blur-3xl");
    } else {
      navbar.classList.remove("bg-surface/75", "backdrop-blur-3xl");
    }

    lastScrollY = currentScrollY;
  };


  // ── Lottie Initialization ──
  const initLottiePlayer = () => {
    const lottiePlayer = document.getElementById('lottie-logo') as any;
    if (lottiePlayer) {
      const applyThemeAndPlay = () => {
        if (!lottiePlayer.isConnected) return; // Prevent infinite orphaned loops if navigated away

        // Force lottieTheme to dark to match the forced light mode
        const lottieTheme = 'dark';
        lottiePlayer.setAttribute('theme-id', lottieTheme);
        
        if (lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.setTheme === 'function') {
          try {
            lottiePlayer.dotLottie.setTheme(lottieTheme);
          } catch(e) {
            console.error('Error setting theme:', e);
          }
        }

        // Delay for appearance transition
        setTimeout(() => {
          if (lottiePlayer.isConnected && lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.play === 'function') {
             lottiePlayer.dotLottie.play();
          }
        }, 500); 
      };

      // Listen for the 'load' event, which fires when the animation file itself is parsed and themes are available.
      // We also listen for 'ready' just in case, but 'load' is the critical one for themes.
      let hasLoaded = false;
      
      const onEventFired = () => {
        if (!hasLoaded) {
          hasLoaded = true;
          applyThemeAndPlay();
        }
      };

      lottiePlayer.addEventListener('load', onEventFired, { once: true });
      lottiePlayer.addEventListener('ready', onEventFired, { once: true });

      // Fallback: Check if it's already loaded (isLoaded property for dotLottie, or just presence of play)
      if (lottiePlayer.isLoaded || (lottiePlayer.dotLottie && lottiePlayer.dotLottie.isLoaded)) {
        onEventFired();
      } else {
        // Ultimate fallback for Safari edge cases where events might be missed over Astro navigations
        const fallbackInterval = setInterval(() => {
          if (lottiePlayer.isLoaded || (lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.play === 'function')) {
            clearInterval(fallbackInterval);
            onEventFired();
          }
        }, 200);
        // Clear interval after 5 seconds to prevent memory leaks
        setTimeout(() => clearInterval(fallbackInterval), 5000);
      }
    }
  };

  // ── Setup Function to run on Page Load ──
  const setupPage = () => {

    // 1. Initialize scroll and listeners
    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll);
    handleScroll();

    document.querySelectorAll<HTMLAnchorElement>('[data-home-link]').forEach(link => {
      // Avoid attaching multiple times
      if (!link.hasAttribute('data-listener-attached')) {
        link.addEventListener('click', (e) => {
          if (window.location.pathname === '/') {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
        link.setAttribute('data-listener-attached', 'true');
      }
    });

    // 2. Initialize Lottie
    initLottiePlayer();

  };

  // Astro view transitions trigger this event
  document.addEventListener('astro:page-load', setupPage);
  
  // Initial page load bootstrapping
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    setupPage();
  } else {
    document.addEventListener('DOMContentLoaded', setupPage);
  }


</script>
