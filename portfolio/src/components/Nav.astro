---
import { getSiteSettings } from '../lib/queries';

const settings = await getSiteSettings();
const links = (settings?.navLinks || [
  { label: 'Writing', href: '/writing' },
  { label: 'Contact', href: '/contact' },
]).filter((link: any) => link.label.toLowerCase() !== 'archive');
const siteName = settings?.siteName || 'Ben Hickman Photography Portfolio';
---
<script src="https://unpkg.com/@lottiefiles/dotlottie-wc@latest/dist/dotlottie-wc.js" type="module"></script>
<nav id="navbar" class="fixed top-0 left-0 w-full z-50 px-8 py-6 text-primary transition-all duration-300">
  <div class="flex items-center justify-between w-full">
    <!-- Left: Logo/Name -->
    <a href="/" data-home-link class="max-[650px]:hidden flex items-center gap-4 hover:opacity-50 transition-opacity">
      <div class="flex gap-1">
        <span class="w-8 h-[1px] bg-current"></span>
        <span class="w-4 h-[1px] bg-current"></span>
      </div>
      <span class="text-[10px] uppercase tracking-[0.2em] font-medium">Ben Hickman</span>
    </a>

    <!-- Center: Brand Logo -->
    <div class="absolute left-1/2 -translate-x-1/2">
      <a href="/" data-home-link class="flex items-center justify-center">
        <dotlottie-wc id="lottie-logo" src="/animated_abstract_logo.lottie" background="transparent" speed="1" class="h-[4.2rem] w-[4.2rem] mt-2"></dotlottie-wc>
      </a>
    </div>

    <!-- Right: Navigation Links + Theme Toggle -->
    <div class="flex items-center gap-8 ml-auto">
      {links.map(link => (
        <a href={link.href}
           class={`text-[10px] uppercase tracking-[0.2em] font-medium hover:opacity-50 transition-opacity ${link.label === 'Archive' ? 'max-[650px]:hidden' : ''} ${link.label === 'Contact' ? 'max-[500px]:hidden' : ''}`.trim()}>
          {link.label}
        </a>
      ))}

      <!-- Theme Toggle Switch -->
      <button
        id="theme-toggle"
        role="switch"
        aria-checked="false"
        aria-label="Toggle dark mode"
        class="theme-switch"
      >
        <span class="theme-switch-knob"></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .theme-switch {
    position: relative;
    display: flex;
    align-items: center;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    border: 1px solid currentColor;
    background: transparent;
    padding: 2px;
    cursor: pointer;
    flex-shrink: 0;
    opacity: 1;
    transition: opacity 300ms;
  }

  .theme-switch:hover {
    opacity: 0.5;
  }

  .theme-switch-knob {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: currentColor;
    transform: translateX(0);
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  /* Knob slides right when dark mode is active */
  :global([data-theme="dark"]) .theme-switch-knob {
    transform: translateX(16px);
  }
</style>

<script>
  let lastScrollY = window.scrollY;
  let navHidden = false;

  const handleScroll = () => {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;
    const currentScrollY = window.scrollY;
    const lottiePlayer = document.getElementById('lottie-logo') as any;

    if (currentScrollY > lastScrollY && currentScrollY > 50) {
      if (!navHidden) {
        navbar.classList.add("-translate-y-full");
        navHidden = true;
        if (lottiePlayer && lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.setMode === 'function') {
          lottiePlayer.dotLottie.setMode('reverse');
          lottiePlayer.dotLottie.play();
        }
      }
    } else {
      if (navHidden) {
        navbar.classList.remove("-translate-y-full");
        navHidden = false;
        if (lottiePlayer && lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.setMode === 'function') {
          lottiePlayer.dotLottie.setMode('forward');
          lottiePlayer.dotLottie.play();
        }
      }
    }

    if (currentScrollY > 20) {
      navbar.classList.add("bg-surface/75", "backdrop-blur-3xl");
    } else {
      navbar.classList.remove("bg-surface/75", "backdrop-blur-3xl");
    }

    lastScrollY = currentScrollY;
  };

  // ── Theme Apply Function ──
  function applyTheme(theme: string) {
    const html = document.documentElement;
    const toggle = document.getElementById('theme-toggle');
    
    // Prevent infinite loop by checking current value
    if (html.getAttribute('data-theme') !== theme) {
      html.setAttribute('data-theme', theme);
    }
    
    localStorage.setItem('theme', theme);
    if (toggle) {
      toggle.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false');
    }
    
    // Sync Lottie animation theme (Inverted to match Token Config)
    const lottieTheme = theme === 'dark' ? 'light' : 'dark';
    const lottiePlayer = document.getElementById('lottie-logo') as any;
    if (lottiePlayer) {
      const currentThemeId = lottiePlayer.getAttribute('theme-id');
      if (currentThemeId !== lottieTheme) {
        lottiePlayer.setAttribute('theme-id', lottieTheme);
        if (lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.setTheme === 'function') {
          lottiePlayer.dotLottie.setTheme(lottieTheme);
        }
      }
    }
  }

  // ── Lottie Initialization ──
  const initLottiePlayer = () => {
    const lottiePlayer = document.getElementById('lottie-logo') as any;
    if (lottiePlayer) {
      const startAnimation = () => {
        if (!lottiePlayer.isConnected) return; // Prevent infinite orphaned loops if navigated away

        if (lottiePlayer.dotLottie && typeof lottiePlayer.dotLottie.play === 'function') {
          // When engine is ready, ensure theme matches exactly BEFORE playing
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
          const lottieTheme = currentTheme === 'dark' ? 'light' : 'dark';
          lottiePlayer.setAttribute('theme-id', lottieTheme);
          if (typeof lottiePlayer.dotLottie.setTheme === 'function') {
            lottiePlayer.dotLottie.setTheme(lottieTheme);
          }

          // Delay for appearance transition
          setTimeout(() => {
            if (lottiePlayer.isConnected) {
               lottiePlayer.dotLottie.play();
            }
          }, 500); 
        } else {
           setTimeout(startAnimation, 100);
        }
      }
      startAnimation();
    }
  };

  // ── Setup Function to run on Page Load ──
  const setupPage = () => {
    const html = document.documentElement;
    const toggle = document.getElementById('theme-toggle');

    // 1. Initialize scroll and listeners
    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll);
    handleScroll();

    document.querySelectorAll<HTMLAnchorElement>('[data-home-link]').forEach(link => {
      // Avoid attaching multiple times
      if (!link.hasAttribute('data-listener-attached')) {
        link.addEventListener('click', (e) => {
          if (window.location.pathname === '/') {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
        link.setAttribute('data-listener-attached', 'true');
      }
    });

    // 2. Initialize Lottie
    initLottiePlayer();

    // 3. Sync initial theme
    const currentTheme = html.getAttribute('data-theme') || 'light';
    applyTheme(currentTheme);

    // 4. Attach toggle listener
    if (toggle && !toggle.hasAttribute('data-listener-attached')) {
      toggle.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        applyTheme(next);
      });
      toggle.setAttribute('data-listener-attached', 'true');
    }
  };

  // Astro view transitions trigger this event
  document.addEventListener('astro:page-load', setupPage);
  
  // Initial page load bootstrapping
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    setupPage();
  } else {
    document.addEventListener('DOMContentLoaded', setupPage);
  }

  // Optional root observer to catch theme changes forced by unrelated scripts
  let observerInitialized = false;
  if (!observerInitialized) {
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
          const newTheme = document.documentElement.getAttribute('data-theme');
          if (newTheme) applyTheme(newTheme);
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    observerInitialized = true;
  }
</script>
