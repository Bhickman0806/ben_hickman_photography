---
import { PortableText } from 'astro-portabletext';
import BookPhotoImage from '../BookPhotoImage.astro';
import PullQuoteBlock from '../../essays/PullQuoteBlock.astro';
import type { BookSpread } from '../../../lib/collectionBook';

interface Props {
  spread: BookSpread;
}

const { spread } = Astro.props;
const imageOnLeft = spread.imagePosition === 'left';
const hasPhoto = Boolean(spread.photo?.image?.asset?._ref?.startsWith?.('image-'));
const hasPortableText = Array.isArray(spread.body) && spread.body.length > 0;
const hasPlainText = typeof spread.body === 'string' && spread.body.length > 0;

const ptComponents = {
  type: {
    pullQuote: PullQuoteBlock,
  },
};
---

<section class="spread spread-text-image w-full h-full flex items-center px-6 md:px-12 py-24">
  <div class:list={[
    'w-full max-w-6xl mx-auto grid gap-10 md:gap-16 items-center',
    hasPhoto ? 'md:grid-cols-2' : 'max-w-3xl'
  ]}>
    {hasPhoto && (
      <div class:list={['relative aspect-[4/5] overflow-hidden rounded-sm bg-[var(--color-border)]', imageOnLeft ? 'md:order-1' : 'md:order-2']}>
        <BookPhotoImage photo={spread.photo} width={1200} aspectRatio={4/5} sizes="(min-width: 768px) 45vw, 100vw" />
      </div>
    )}
    <div class:list={['book-body', imageOnLeft ? 'md:order-2' : 'md:order-1']}>
      {hasPortableText && (
        <PortableText value={spread.body} components={ptComponents} />
      )}
      {hasPlainText && (
        <p class="font-sans text-base md:text-lg font-light text-muted leading-[1.75]">{spread.body}</p>
      )}
    </div>
  </div>
</section>

<style>
  .book-body {
    font-family: "Inter", sans-serif;
    line-height: 1.75;
    color: var(--color-text-muted);
    font-weight: 300;
  }
  .book-body :global(p) {
    font-size: 1.05rem;
    margin-bottom: 1em;
  }
  .book-body :global(h2) {
    font-family: "Instrument Serif", serif;
    font-size: 1.6rem;
    line-height: 1.25;
    color: var(--color-text-primary);
    font-weight: 400;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }
  .book-body :global(.pull-quote) {
    margin: 2rem 0;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }
  .book-body :global(.pull-quote p) {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.4;
    color: var(--color-text-primary);
  }
</style>
