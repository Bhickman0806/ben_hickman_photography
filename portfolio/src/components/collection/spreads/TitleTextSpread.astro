---
import type { BookSpread } from '../../../lib/collectionBook';

interface Props {
  spread: BookSpread;
}

const { spread } = Astro.props;
---

<section class="spread spread-title-text w-full h-full flex items-center justify-center px-6 md:px-16 py-24">
  <div class="max-w-3xl text-center">
    {spread.subtitle && (
      <p class="text-[0.625rem] font-bold uppercase tracking-[0.2em] text-muted mb-6">
        {spread.subtitle}
      </p>
    )}
    {spread.heading && (
      <h2 class="font-display text-4xl md:text-6xl lg:text-7xl leading-[1.05] tracking-tight mb-8">
        {spread.heading}
      </h2>
    )}
    {spread.body && typeof spread.body === 'string' && (
      <p class="font-sans text-base md:text-lg font-light text-muted leading-[1.75] max-w-2xl mx-auto">
        {spread.body}
      </p>
    )}
  </div>
</section>
