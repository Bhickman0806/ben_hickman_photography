---

interface Props {
  subtitle: string;
  title: string;
  description: string;
  image: string; // Full res URL for lightbox
  src?: string;  // Responsive src
  srcset?: string;
  sizes?: string;
  alt: string;
  linkHref: string;
  linkLabel: string;
  reverse?: boolean;
  featured?: boolean;
}

const { subtitle, title, description, image, src, srcset, sizes, alt, linkHref, linkLabel, reverse, featured } = Astro.props;
---
<a href={linkHref} class="project-row group grid grid-cols-1 md:grid-cols-12 gap-16 md:gap-8 items-center">
  
  <!-- Text Column -->
  <div class:list={["md:col-span-4 space-y-8", reverse ? "md:order-2" : ""]}>
    <div>
      <span class="text-[0.625rem] font-bold text-muted uppercase tracking-[0.2em] block mb-6">
        {subtitle}
      </span>
      <h3 class="font-display text-5xl md:text-6xl lg:text-7xl leading-[1.05] tracking-tight mb-8">{title}</h3>
      <p class="font-sans text-[0.9375rem] font-light text-muted leading-[1.75] max-w-md">{description}</p>
    </div>
    <div class="pt-0 md:pt-8 md:border-t border-border-color-DEFAULT mt-2 md:mt-0">
      <div class="inline-flex items-center gap-4 text-[10px] font-bold uppercase tracking-[0.2em] group-hover:opacity-60 transition-opacity">
        {linkLabel}
        <span class="material-icons text-sm group-hover:translate-x-2 transition-transform">east</span>
      </div>
    </div>
  </div>

  <!-- Image Column -->
  <div class:list={["md:col-span-8 w-full block", reverse ? "md:order-1 md:pr-24" : "md:pl-24"]}>
    <div class="aspect-[16/10] overflow-hidden rounded-lg bg-gray-100 relative">
      <img
        alt={alt}
        src={src || image}
        srcset={srcset}
        sizes={sizes}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      />
      <div class="absolute inset-0 bg-black/10 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
    </div>
    <!-- Mobile Horizontal Line Separator -->
    <div class="md:hidden mt-8 border-t border-border-color-DEFAULT w-full"></div>
  </div>
</a>

<style>
  .project-row {
    padding: 2rem 1.5rem;
    margin: 0 -1.5rem;
    border-radius: 1rem;
    transition: background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    color: inherit;
    text-decoration: none;
  }
  .project-row:hover {
    background-color: color-mix(in srgb, var(--color-text-primary) 4%, transparent);
  }
  @media (min-width: 768px) {
    .project-row {
      padding: 3rem 2.5rem;
      margin: 0 -2.5rem;
    }
  }
</style>
