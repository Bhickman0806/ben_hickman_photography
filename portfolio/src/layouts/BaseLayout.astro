---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ChatAgent from '../components/ChatAgent.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Ben Hickman Photography",
  description = "Cinematic, architectural and unapologetically bold photography.",
  image = "/og-image.jpg"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    
    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-48x48.png?v=2" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" sizes="any" href="/favicon.ico?v=2" />
    <link rel="mask-icon" href="/favicon.svg?v=2" color="#000000" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <meta name="apple-mobile-web-app-title" content="Ben Hickman" />
    <link rel="manifest" href="/site.webmanifest?v=2" />

    <!-- Theme init: read localStorage before render to prevent flash -->
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme');
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- Fonts: Inter (text) and Instrument Serif (headings) -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
        rel="stylesheet" />
    <!-- Material Icons for UI elements like arrows and stars -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

    <!-- Page transition -->
    <style>
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      body {
        animation: fadeIn 0.6s ease-out forwards;
      }
      body.fade-out {
        opacity: 0;
        transition: opacity 0.5s ease-in-out;
      }
    </style>
  </head>
  <body class="bg-surface text-primary transition-colors duration-500 font-sans antialiased overflow-x-hidden">
    <Nav />
    
    <main>
      <slot />
    </main>

    <Footer />
    
    <!-- Optional: Global scripts/islands -->
  
    <!-- Global Chat Button -->
    <ChatAgent />

    <!-- Page transition script -->
    <script>
      document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (!link) return;
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('javascript:') || link.target === '_blank') return;
        // If this is a home link and we're already on the homepage, let Nav.astro handle it (smooth scroll, no reload)
        if (link.hasAttribute('data-home-link') && window.location.pathname === '/') return;
        e.preventDefault();
        document.body.classList.add('fade-out');
        setTimeout(function() {
          window.location.href = href;
        }, 500);
      });
    </script>
  </body>
</html>
